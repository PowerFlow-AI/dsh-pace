{
  "name": "@powerflow-ai/dsh-pace",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowerFlow-AI/dsh-pace.git"
  },
  "type": "module",
  "description": "Keep DSH searches scoped and foreground waits short.",
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "retry.js",
    "shell.js",
    "pace.test.js",
    "scripts/check-release.mjs",
    "scripts/check-manifest.mjs",
    "scripts/replay.mjs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "replay": "node scripts/replay.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:release": "npm test && npm run check:manifest && node scripts/check-release.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
